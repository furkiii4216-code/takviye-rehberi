rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'furkiii4216@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /supplements/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'photoUrl', 'email', 'username_lowercase', 'avatar', 'health', 'healthLog', 'fullName'])
        && (!('fullName' in request.resource.data)
            || (request.resource.data.fullName is string && request.resource.data.fullName.size() <= 60))
        && (!('avatar' in request.resource.data)
            || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 4))
        && (!('health' in request.resource.data)
            || (request.resource.data.health is map
                && request.resource.data.health.keys().hasOnly(['gender', 'birthYear', 'height', 'goalWeight', 'blood', 'note'])))
        && (!('healthLog' in request.resource.data)
            || (request.resource.data.healthLog is list && request.resource.data.healthLog.size() <= 400))
        && (!('username' in request.resource.data)
            || (request.resource.data.username is string
                && request.resource.data.username.size() >= 1
                && request.resource.data.username.size() <= 40))
        && (!('photoUrl' in request.resource.data)
            || (request.resource.data.photoUrl is string
                && request.resource.data.photoUrl.size() < 200000));
      allow delete: if false;
    }

    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /fcm_tokens/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
